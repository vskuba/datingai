# Настройки DatingAi. Файл — образец: рабочие значения кладутся в `.env`, а
# машинные особенности — в `.env.local` (пароли, адреса) либо, если речь о
# публикуемых портах, в сам `.env`: их подставляет docker, а он `.env.local`
# не читает.
#
# Секретов здесь нет и быть не должно: `.env.dist` лежит в репозитории.

# --- База анкет -------------------------------------------------------------
# Своя, отдельная от RhapsodyAi: этот проект владеет учётками и перепиской, и
# делить с соседом одну базу значило бы, что «отдельный проект» существует только
# на словах.
MYSQL_HOST=dating_mysql
MYSQL_PORT=3306
MYSQL_DATABASE=dating
MYSQL_USER=developer
MYSQL_PASSWORD=password

# ⚠⚠ **Печать каждого запроса в журнал — отладочная, и на проде она дорога.**
# Замерено на живом сервере: воркер писал 6832 строки в минуту, из них 6809 —
# `[MySQL SQL]` и `[MySQL POOL]`. Полтора гигабайта логов в сутки с одного
# контейнера при двадцати трёх полезных строках в минуту.
#
# `MYSQL_LOG_QUERIES=0` гасит текст запросов, `MYSQL_LOG_POOL=0` — движение
# соединений в пуле. Гасят их порознь: первым отлаживают «что спросили у базы»,
# вторым — «куда делись соединения», и второе нужно редко.
#
# ⚠ Умолчание — печатать, как было всегда. Ошибки запросов (`[MySQL ERROR]`) и
# сорвавшийся чекаут пула печатаются **при любом значении**: это не поток, а беда.
MYSQL_LOG_QUERIES=0
MYSQL_LOG_POOL=0

# --- RhapsodyAi -------------------------------------------------------------
# Адрес соседа по имени сервиса в общей сети, а не `localhost`: обращаются к нему
# и сервер, и воркер, у каждого свой петлевой адрес.
#
# Токен — `user_access_token` служебной учётки `dating_service` в RhapsodyAi. Ей
# выданы права `browser:*` (водить браузер) и `agent:create` (заводить агента
# анкеты). Без токена проект поднимется, но работать не сможет: в журнале будет
# «не задан RHAPSODY_TOKEN — обращаться нечем».
RHAPSODY_URL=http://uvicorn:8000
RHAPSODY_TOKEN=

# --- Очередь ----------------------------------------------------------------
# Именно `REDIS_URL`, а не пара host/port: общая библиотека читает эту переменную
# и по умолчанию берёт `redis://redis:6379` — адрес Redis соседа, который виден в
# общей сети. Без явного значения смены держателя уходили в его очередь, где их
# подхватывал бы чужой воркер и падал на импорте наших модулей.
REDIS_URL=redis://dating_redis:6379

# --- Приложение -------------------------------------------------------------
# Ключ подписи сессионной куки. На рабочей установке — свой, длинный и случайный.
SESSION_SECRET_KEY=change-me

DATA_DIR=data
UVICORN_DIR=uvicorn

# Куда пишется `app.log`. Путь общая библиотека складывает из `DATA_DIR` и этого
# ключа, и **пустое значение здесь не значит «по умолчанию»**: склейка даёт
# `data//app.log`, то есть журнал ложится прямо в корень `data` вперемешку с
# дампами и шаблонами. Отсюда явное значение.
LOG_DIR=logs

# Под каким URI панель видна снаружи. Пусто — в корне домена.
#
# **Сейчас пусто везде, и локально, и на проде**: панель получила своё имя
# `dating.92.5.17.195.sslip.io`, Caddy соседа проксирует его в корень. Раньше
# домен был общим и делился по пути (`/dating`) — отсюда и переменная.
#
# Оставлена не для симметрии: если панель когда-нибудь снова выставят под
# префиксом, `{{ base }}` в шаблонах уже разведёт пути. Прокси префикс срезает,
# поэтому приложение в любом случае видит пути от корня; префикс нужен только
# разметке, чтобы браузер просил статику и API у нас, а не у соседа.
BASE_PATH=

# Порты **на хосте**. У соседа заняты 8011 и 3302 — здесь соседние, чтобы обе
# установки поднимались на одной машине одновременно.
#
# `MYSQL_PORT_HOST` — не то же, что `MYSQL_PORT` выше: тот означает порт, по
# которому к базе ходит приложение внутри сети (3306), и публиковать наружу надо
# не его. Машина, где эти порты заняты чужими проектами, правит их **в `.env`**:
# `.env.local` тут не поможет — его читает питон, а подстановкой в compose
# занимается docker, и он знает только `.env` в корне проекта.
UVICORN_PORT=8021
MYSQL_PORT_HOST=3312

# --- phpMyAdmin -------------------------------------------------------------
# Порт контейнера с веб-мордой к своей базе. Соседние заняты чужими установками
# (9634-9636), поэтому первый свободный за ними.
PHPMYADMIN_PORT=9637

# Адрес, который открывается по ссылке в шапке панели. Не выводится из порта:
# ссылку жмёт человек в своём браузере, а не сервер. На проде контейнер свой, но
# порт опубликован на петле — до него админ ходит SSH-туннелем, поэтому и там
# адрес начинается с `localhost`.
PHPMYADMIN_URL=http://localhost:9637

# --- Учётки панели ----------------------------------------------------------
# Заводятся на старте. Пароли из образца знают все — на рабочей установке свои.
#
# Администратор: анкеты плюс устройство установки (seed, бэкапы, база). Заводится,
# только если таблица учёток пуста, иначе в свежую панель нечем войти.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Оператор анкет: только страница анкет и её ручки. Заводится, если такого логина
# ещё нет, — роль появилась позже самой панели, и на живой установке учётка
# должна завестись без пересоздания базы.
DATING_USERNAME=dating
DATING_PASSWORD=change-me

# --- Google Диск: фотографии девушек для вкладки «Галерея» -------------------
# Путь к JSON-ключу **сервисного аккаунта** (IAM → Service Accounts → Keys).
# ⚠ Путь, а не само содержимое: приватный ключ в переменной читает всякий, кто
# видит окружение процесса. Относительный путь считается от корня проекта, а не
# от рабочего каталога, — чтобы задание планировщика и сюита находили ключ так же,
# как панель.
# ⚠⚠ Каталог `google_drive/` в `.gitignore`: ключу в репозитории не место.
# ⚠ Аккаунт видит **только расшаренное**. Общую папку надо один раз расшарить на
# его адрес (`client_email` из того же JSON) правом «Читатель»; не расшарили —
# Диск отвечает не отказом, а пустотой.
GOOGLE_DRIVE_KEY=google_drive/service-account.json

# Имя общей папки на Диске, внутри которой лежат папки девушек.
# ⚠ Имя, а не идентификатор: его задаёт человек. Папка девушки внутри зовётся
# **логином анкеты**; иное имя выбирают на вкладке «Галерея».
GOOGLE_DRIVE_FOLDER=Dating
