.env
.env.local
.env.test

# Локальная накладка compose. В репозитории лежит только образец
# (`docker-compose.override.yml.dist`): под рабочим именем файл уезжал бы на
# прод вместе с кодом, и прод поднимался бы с пустой локальной базой.
docker-compose.override.yml
__pycache__/
*.pyc
data/logs/
.idea/
.git_worktree
.env.prod
data/*.log
data/*.log.*
backups/

data/girls

.superpowers

# Дампы и выгрузки из панели. В них пароли учёток на сайтах знакомств и вся
# переписка — место такому файлу рядом с базой, а не в истории git.
# Кадры E2E-прогонов: доказательство на время работы, а не артефакт проекта.
data/e2e/
data/backups/
data/seeds/

.claude-shell

.memsearch

# Рабочие заметки агентов-помощников: к проекту отношения не имеют.
.deepseek-harness/
.dsh

# Ключи сервисных аккаунтов Google: каталог в рабочей копии, в репозиторий
# ему нельзя. ⚠ Без завершающего слэша — правило обязано ловить и **ссылку**
# на этот каталог: в worktree его подключают симлинком, и правило со слэшем
# такую ссылку пропускает, то есть ключ становится видимым для коммита.
google_drive
