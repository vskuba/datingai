.env
.env.local
.env.test

# Локальная накладка compose. В репозитории лежит только образец
# (`docker-compose.override.yml.dist`): под рабочим именем файл уезжал бы на
# прод вместе с кодом, и прод поднимался бы с пустой локальной базой.
docker-compose.override.yml
__pycache__/
*.pyc
data/logs/
.idea/
.git_worktree
.env.prod
data/*.log
data/*.log.*
backups/

data/girls

.superpowers

# Дампы и выгрузки из панели. В них пароли учёток на сайтах знакомств и вся
# переписка — место такому файлу рядом с базой, а не в истории git.
# Кадры E2E-прогонов: доказательство на время работы, а не артефакт проекта.
data/e2e/
data/backups/
data/seeds/

.claude-shell

.memsearch

# Рабочие заметки агентов-помощников: к проекту отношения не имеют.
.deepseek-harness/
.dsh

# Ключи сервисных аккаунтов Google: каталог в рабочей копии, в репозиторий
# ему нельзя. ⚠ Без завершающего слэша — правило обязано ловить и **ссылку**
# на этот каталог: в worktree его подключают симлинком, и правило со слэшем
# такую ссылку пропускает, то есть ключ становится видимым для коммита.
google_drive

# Черновики и подпорки одной работы: скрипт-однодневка, дамп шага workflow,
# выписка строк из базы. К проекту отношения не имеют, живут днями, а в
# `git status` стояли вечно — и каждый раз их разбирали заново, чтобы снова
# решить «не коммитить».
#
# ⚠⚠ Правило не только про опрятность. В таких папках оказываются **выгрузки
# переписки**: `.tmp_dating_docs/` держала нашу с девяти живых диалогов. Это та
# же причина, по которой выше закрыты `data/backups/` и `data/seeds/`, — и здесь
# она острее, потому что путь выдуманный и под запрет сам не попадал. А взять
# такую папку в коммит легко: `git commit` без путей забирает **весь** индекс,
# включая чужой `git add` из соседней сессии.
.scratch/
.tmp_dating_docs/
scratchpad/

# ⚠ Черновик тем общения — файл, а не узор `*_draft.md`: узор однажды спрятал бы
# настоящий документ проекта, и спрятал бы молча. Темы заполняются во вкладке
# «Topic & Action» **у соседа**, здесь черновику не место и подавно.
talk_topics_instructions_draft.md
