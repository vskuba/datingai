# Локальная установка: то, чем машина разработчика отличается от прода.
#
# Файл — **образец**, как `.env.dist`. Рабочая копия делается один раз при
# настройке и в репозиторий не попадает:
#
#   cp docker-compose.override.yml.dist docker-compose.override.yml
#
# Compose читает `docker-compose.override.yml` **сам**, без `-f`: на машине
# разработчика `docker compose up -d` поднимает локальный набор, а на проде, где
# копии нет, та же команда поднимает прод. Базовая конфигурация (прод) — в
# `docker-compose.yml`.
#
# Почему копия, а не сам файл под рабочим именем: под рабочим именем он уезжал бы
# на прод вместе с кодом, и прод поднимался бы с пустой локальной базой. Здесь же
# на сервере нет ни образца под этим именем, ни рабочей копии — ошибиться нечем.
#
# Разработке нужна установка, которую можно уронить и поднять, не спрашивая
# соседа, поэтому здесь появляются свои движки:
#
#   * `dating_mysql` — своя база анкет вместо MySQL RhapsodyAi;
#   * `dating_redis` — своя очередь вместо его Redis;
#   * `dating_phpmyadmin` — веб-морда к своей базе (на проде её роль исполняет
#     phpMyAdmin соседа: база там на его сервере и видна оттуда).
#
# И одно, чего на проде нет: **общая сеть с RhapsodyAi**. Прод ходит к соседу по
# публичному HTTPS, а локально `RHAPSODY_URL` — имя его контейнера, и без общей
# сети оно не резолвится.
#
# Машинные особенности правятся не здесь, а в окружении — тогда рабочая копия
# остаётся такой же, как образец, и расходиться им незачем. Пароли и адреса — в
# `.env.local` (читается поверх `.env`, в репозиторий не попадает), а **порты — в
# `.env`**: подстановкой `${...}` занимается docker, и он знает только его.

services:
  dating_uvicorn:
    # Прямой вход в панель: локально Caddy соседа перед ней не стоит, и слушать
    # надо на всех адресах, а не на петле, как в базовом слое.
    #
    # `!override`: списки `ports` при склейке **дописываются**, и без него к
    # локальной публикации добавилась бы прод-строка `127.0.0.1:8021:8000` —
    # тот же порт хоста дважды, и compose падает на конфликте.
    ports: !override
      - "${UVICORN_PORT:-8021}:8000"
    # `!override` вместо добавления: списки `env_file` при склейке файлов
    # **дописываются**, и без него прод-слой остался бы поверх локального —
    # разработка пошла бы в боевую базу. `.env.prod` лежит и на этой машине,
    # так что «файла нет, значит не подхватится» здесь не работает.
    env_file: !override
      - .env
    # Сеть соседа — **только локально**. `RHAPSODY_URL` здесь `http://uvicorn:8000`,
    # то есть имя его контейнера, а имя резолвится лишь в общей сети. На проде
    # общей сети нет и не надо: там адрес соседа — публичный HTTPS.
    #
    # Пока сеть была в базовом файле, локальная установка держалась на ней сама
    # собой. Когда прод от неё отвязали, накладка осталась без замены, и это не
    # сломалось сразу: контейнеры просто не пересоздавали. Первый же
    # `--force-recreate` дал `Temporary failure in name resolution` и шесть
    # падений в сюите.
    networks:
      - dating-net
      - rhapsody-net
    depends_on:
      dating_mysql:
        condition: service_healthy

  dating_worker:
    # Локально адрес очереди известен заранее и берётся из имени сервиса.
    command: rq worker --url redis://dating_redis:6379 dating
    env_file: !override
      - .env
    # Воркеру сеть соседа нужна по той же причине, что и панели: ответы агента он
    # берёт у него (`POST /chat/ask`).
    networks:
      - dating-net
      - rhapsody-net
    depends_on:
      - dating_redis
      - dating_uvicorn

  dating_mysql:
    image: mysql:8.0
    container_name: dating_mysql
    command: mysqld --sql-mode="NO_ENGINE_SUBSTITUTION"
    # По той же причине, что у панели: без `!override` в локальный MySQL приехало
    # бы прод-окружение из базового слоя, и база поднялась бы с боевым паролем.
    env_file: !override
      - .env
    # Порт **на хосте** — свой ключ, а не `MYSQL_PORT`. Тот означает порт, по
    # которому к базе ходит приложение внутри сети (3306), и подставленный сюда
    # публиковал наружу 3306 — ровно тот порт, который занят чужим MySQL и
    # ради которого здесь и заведён отдельный `MYSQL_PORT_HOST`.
    ports:
      - "${MYSQL_PORT_HOST:-3312}:3306"
    environment:
      - MYSQL_DATABASE=dating
      - MYSQL_USER=developer
      - MYSQL_PASSWORD=password
      - MYSQL_ROOT_PASSWORD=password
    volumes:
      - dating_mysql_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-p$$MYSQL_ROOT_PASSWORD", "--protocol", "tcp"]
      interval: 5s
      timeout: 5s
      retries: 20
    networks:
      - dating-net
    restart: always

  dating_redis:
    image: redis:7-alpine
    container_name: dating_redis
    networks:
      - dating-net
    restart: always

  # Веб-морда к своей базе — из шапки панели («Инструменты → phpMyAdmin»).
  #
  # Своя, а не соседская: у RhapsodyAi phpMyAdmin смотрит в его MySQL, а `dating`
  # локально живёт в отдельном контейнере, и оттуда до неё не дойти.
  #
  # Образ официальный (`library/phpmyadmin`): в отличие от `phpmyadmin/phpmyadmin`
  # у него есть arm64-вариант, и на машине с Apple silicon он не тянет эмуляцию.
  dating_phpmyadmin:
    image: phpmyadmin:latest
    container_name: dating_phpmyadmin
    ports: !override
      - "${PHPMYADMIN_PORT:-9637}:80"
    environment:
      PMA_HOST: dating_mysql
      MYSQL_USERNAME: ${MYSQL_USER:-developer}
      MYSQL_ROOT_PASSWORD: password
    depends_on:
      - dating_mysql
    networks:
      - dating-net
    restart: always

networks:
  # Сеть RhapsodyAi. `external` — её заводит его compose, мы только подключаемся;
  # создавать её здесь значило бы гонку за то, чей проект её сделает первым.
  #
  # ⚠ Цена: **без соседа локальная установка не поднимется вовсе** — compose
  # скажет «network rhapsodyai_os-net declared as external, but could not be
  # found». Это осознанно: `RHAPSODY_URL` всё равно указывает на его контейнер, и
  # подняться без него значило бы получить панель, которая падает на первом же
  # списке сайтов. Лучше честный отказ на старте, чем 502 из середины работы.
  #
  # Имя — не `datingai_*`: сеть чужая, и префикс проекта ей docker не приписывает.
  rhapsody-net:
    external: true
    name: rhapsodyai_os-net

volumes:
  dating_mysql_data:
