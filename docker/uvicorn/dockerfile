# Образ DatingAi: обычный Python и ничего больше.
#
# У соседа образ тяжёлый — там Chromium, torch и модели распознавания. Здесь их
# нет и быть не должно: браузер водит RhapsodyAi, ответы сочиняет он же, а этот
# проект держит базу анкет и вебсокет чата. Отсюда и сборка в считанные секунды.
FROM python:3.11-slim

RUN ln -sf /usr/share/zoneinfo/Etc/UTC /etc/localtime

# `default-mysql-client` — чтобы можно было заглянуть в базу изнутри контейнера,
# не поднимая ничего дополнительно.
RUN apt-get update && apt-get install -y --no-install-recommends \
    default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY docker/uvicorn/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Голова для E2E-прогона: headless Chromium и numpy с Pillow под замеры кадра.
#
# ⚠⚠ Это НЕ тот браузер, которым проект работает с анкетами: тот живёт отдельным
# сервисом в RhapsodyAi, держит сессии и присутствие на сайте, и ходят в него по
# HTTP (`/api/browser/*`). Здесь — одноразовая голова под снимок: открыл, снял,
# закрыл. Занимать общий пул вкладок ради кадра нельзя — там рядом работает
# человек, а мест всего 25.
#
# ⚠ `chromium-headless-shell`, а не полный `chromium`: ~130 МБ против ~450.
# Окна, расширения и звук прогону не нужны — ему нужен рендер и снимок.
#
# ⚠ Слой стоит ПЕРЕД `COPY . /app` намеренно: правка кода проекта не должна
# пересобирать браузер. Обратный порядок стоил бы нескольких минут на каждой
# выкладке.
RUN pip install --no-cache-dir playwright==1.63.0 numpy Pillow \
    && playwright install chromium-headless-shell --with-deps

COPY . /app

# `py_modules` лежит отдельным каталогом и подключается путём, а не установкой:
# это общая библиотека, живущая своим репозиторием.
ENV PYTHONPATH="/app:/app/py_modules"

RUN mkdir -p data/logs && chmod -R 777 data/logs

CMD ["uvicorn", "main_uvicorn:app", "--host", "0.0.0.0", "--port", "8000"]
